# Server
PORT=3000
NODE_ENV=development

# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=safedrive
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=30m

# CORS
CORS_ORIGINS=http://localhost:3001,http://localhost:8081

# Rate Limiting
RATE_LIMIT_PUBLIC_MAX=100
RATE_LIMIT_PUBLIC_WINDOW_MS=900000
RATE_LIMIT_AUTHENTICATED_MAX=1000
RATE_LIMIT_AUTHENTICATED_WINDOW_MS=900000
RATE_LIMIT_BUSINESS_MAX=5000
RATE_LIMIT_BUSINESS_WINDOW_MS=900000

# Blockchain (Base L2 - ERC-4337 Account Abstraction)
BASE_RPC_URL=https://mainnet.base.org
BASE_CHAIN_ID=8453
BACKEND_SIGNER_PRIVATE_KEY=your-backend-signer-private-key
ERC4337_BUNDLER_URL=https://api.pimlico.io/v2/8453/rpc?apikey=your-api-key
ERC4337_PAYMASTER_URL=https://api.pimlico.io/v2/8453/rpc?apikey=your-api-key
ACCOUNT_FACTORY_ADDRESS=0x...your-simple-account-factory-address
ENTRY_POINT_ADDRESS=0x5FF137D4b0FDCD49DcA30c7CF57E578a026d2789
